{
  "appId": "com.albayan.app",
  "appName": "Albayan",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true,
      "connectTimeout": 15000,
      "readTimeout": 30000
    },
    "CapacitorCookies": {
      "enabled": true
    },
    "SystemBars": {
      "insetsHandling": "css",
      "style": "DEFAULT",
      "hidden": false,
      "animation": "NONE"
    },
    "Keyboard": {
      "resize": "body",
      "resizeOnFullScreen": true,
      "autoBackdropColor": "auto"
    },
    "LocalNotifications": {
      "sound": "default"
    }
  }
}
