# Copy this file to .env, then replace CHANGE_ME before starting Docker.
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD

# Local HTTP development defaults. Production HTTPS must use true.
ALBAYAN_COOKIE_SECURE=false
ALBAYAN_TRUST_PROXY_HEADERS=false
ALBAYAN_ENABLE_ONLINE_IMPORT=false

# Optional browser-based first-admin setup. Leave disabled unless you generate
# a long, private, one-time value and enter the same value in the setup screen.
# ALBAYAN_SETUP_TOKEN=CHANGE_ME_USE_A_DIFFERENT_LONG_RANDOM_TOKEN

# Safer alternative: create the first admin with the documented CLI command.
# ALBAYAN_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# ALBAYAN_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_USE_A_STRONG_ADMIN_PASSWORD
# ALBAYAN_BOOTSTRAP_ADMIN_NAME=Admin

# Optional: secure, read-only Meta Ads synchronization. Keep these secrets on
# the SERVER only. Never put them in script.js, a phone app, or localStorage.
# ALBAYAN_META_ACCESS_TOKEN=CHANGE_ME_META_SYSTEM_USER_TOKEN
# ALBAYAN_META_APP_SECRET=CHANGE_ME_META_APP_SECRET
# ALBAYAN_META_AD_ACCOUNT_IDS=123456789,987654321
# ALBAYAN_META_GRAPH_API_VERSION=v25.0
# ALBAYAN_META_BACKGROUND_SYNC=true
# ALBAYAN_META_SYNC_INTERVAL_MINUTES=15
# Automatically discover newly created Meta ads and create accounting-neutral
# Albayan drafts. The first pass creates a baseline and never floods Albayan
# with old account history.
# ALBAYAN_META_AUTO_IMPORT=true
# Fast discovery reads only the newest page from each account. Heavy details
# are paced in small batches so Meta does not delay new-ad visibility.
# ALBAYAN_META_DISCOVERY_INTERVAL_SECONDS=60
# ALBAYAN_META_DISCOVERY_FAST_PAGES=1
# ALBAYAN_META_DISCOVERY_BASELINE_PAGES=25
# ALBAYAN_META_SYNC_BATCH_SIZE=2
# ALBAYAN_META_WORKER_SYNC_INTERVAL_SECONDS=10
# Optional fast-path webhook verification secret. Generate a long random value,
# keep it server-side, and use it when configuring Meta's callback.
# ALBAYAN_META_WEBHOOK_VERIFY_TOKEN=CHANGE_ME_LONG_RANDOM_WEBHOOK_TOKEN
