# Secrets — never commit credentials
.env
.env.local
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Dependencies
node_modules/

# Python caches and local databases
__pycache__/
*.pyc
.pycache_tmp/
.pytest_cache/
.pytest_tmp*/
.tmp/
playwright-report/
test-results/
backups/
server/data/
*.db

# Studio collision repair files (scripts/studio_collision_repair.py keeps them in ~/albayan-repairs)
collision-reversal-*.json
collision-report*.json
collision-choices*.json

# Generated at runtime by the server
script.min.js

# Build outputs and caches
android/.gradle/
android/build/
android/app/build/
android/local.properties

# Android release signing — NEVER commit these
android/key.properties
android/*.jks
android/*.keystore
ios/App/build/
ios/App/DerivedData/

# OS / editor junk
.DS_Store
*.log
.cursor/
.claude/settings.local.json

# Logs directory
logs/
